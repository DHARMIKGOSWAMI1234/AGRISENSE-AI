# ==============================================================================
# SMRITI Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT-SPECIFIC CREDENTIALS.
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.

# --- SERVER CONFIGURATION ---
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="SMRITI Platform Backend"

# --- SECURITY & AUTHENTICATION (JWT) ---
# Generate with: openssl rand -hex 32
SECRET_KEY=smriti_super_secret_development_key_change_in_production_2026_sih
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- POSTGRESQL DATABASE ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smriti_admin
POSTGRES_PASSWORD=smriti_secure_password_dev
POSTGRES_DB=smriti_db
DATABASE_URL=postgresql://smriti_admin:smriti_secure_password_dev@localhost:5432/smriti_db
# For local SQLite backend fallback during testing:
# DATABASE_URL=sqlite:///./smriti_backend.db

# --- CORS SETTINGS ---
# JSON array of origins allowed to access the API
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173"]

# --- ML & ADAPTIVE MODEL ENGINE ---
ML_MODEL_VERSION=v1.0.0
ML_MODELS_PATH=./ml/models/registry
INFERENCE_ENGINE_TYPE=rules_baseline # Options: rules_baseline, sklearn_supervised, hybrid

# --- MOBILE / CLIENT SETTINGS ---
MOBILE_API_BASE_URL=http://10.0.2.2:8000/api/v1 # Android emulator localhost bridge
MOBILE_SYNC_BATCH_SIZE=25
MOBILE_SYNC_INTERVAL_SECONDS=300
MOBILE_OFFLINE_DB_NAME=smriti_local.db

# --- LOCALIZATION & VOICE ---
DEFAULT_LANGUAGE=en # Options: en (English), hi (Hindi), as (Assamese)
TTS_FALLBACK_ENGINE=platform_native # Options: platform_native, offline_onnx
ENABLE_AUDIO_PROMPTS=True

# --- MONITORING & LOGGING ---
LOG_LEVEL=INFO
ENABLE_AUDIT_LOGS=True
